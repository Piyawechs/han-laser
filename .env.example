# han-laser: FITS settings for THIS PC
# Copy this file to .env in the same folder (next to han_laser_ui.pyw), then fill in real values.
# .env holds passwords: it is in .gitignore, never commit / e-mail / paste it.
# Format: KEY=value  (quotes optional; values in .env win over Windows environment variables)
# Restart han-laser after editing .env.

# ---- FITS production (Operator mode): all 5 are needed
FITS_URL=<fits service url>
FITS_PROJECT_ID=<project id>
FITS_USER=<user name>
FITS_PASSWORD=<password>
FITS_REVISION=<revision>

# ---- FITS TEST (Engineer TEST mode): optional
# Leave commented to use the TEST URL built into fits_client and the same
# project / user / password / revision as above.
# FITS_TEST_URL=<fits test service url>
# FITS_TEST_PROJECT_ID=<test project id>
# FITS_TEST_USER=<test user name>
# FITS_TEST_PASSWORD=<test password>
# FITS_TEST_REVISION=<test revision>
